<Window x:Class="TaskbarRunner.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Taskbar Runner · Settings" Width="480" Height="640"
        ResizeMode="NoResize" WindowStartupLocation="CenterScreen"
        Background="#15212B" Foreground="#F1F8F5" FontFamily="Segoe UI" FontSize="13">
  <Window.Resources>
    <Style TargetType="CheckBox">
      <Setter Property="Foreground" Value="#F1F8F5" />
      <Setter Property="Margin" Value="0,8" />
    </Style>
    <Style TargetType="ComboBox">
      <Setter Property="Margin" Value="0,6,0,14" />
      <Setter Property="Padding" Value="8,5" />
    </Style>
    <Style TargetType="Button">
      <Setter Property="Padding" Value="20,9" />
      <Setter Property="Margin" Value="8,0,0,0" />
      <Setter Property="Cursor" Value="Hand" />
    </Style>
  </Window.Resources>
  <Grid Margin="28">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>
    <StackPanel Margin="0,0,0,20">
      <TextBlock Text="TASKBAR RUNNER" Foreground="#8DF0C6" FontSize="12" FontWeight="Bold" />
      <TextBlock Text="ひと休みを、自分のペースで。" FontSize="23" Margin="0,9,0,6" />
      <TextBlock Text="設定はこの PC にだけ保存されます。" Foreground="#AFBCC4" />
    </StackPanel>
    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
      <StackPanel Margin="0,0,12,0">
        <TextBlock Text="GAME" Foreground="#8DF0C6" FontWeight="SemiBold" Margin="0,0,0,12" />
        <TextBlock Text="ゲーム速度" />
        <ComboBox x:Name="Speed" />
        <TextBlock Text="キャラクターサイズ" />
        <ComboBox x:Name="CharacterSize" />
        <TextBlock Text="タスクバーからのオフセット (0–60 px)" />
        <DockPanel Margin="0,10,0,16">
          <TextBlock Text="{Binding ElementName=Offset, Path=Value, StringFormat={}{0:0}}" Width="32" DockPanel.Dock="Right" />
          <Slider x:Name="Offset" Minimum="0" Maximum="60" TickFrequency="1" IsSnapToTickEnabled="True" />
        </DockPanel>
        <TextBlock Text="描画の負荷" />
        <ComboBox x:Name="Fps" />
        <CheckBox x:Name="StartWithWindows" Content="Windows のサインイン時に起動する" />
        <TextBlock x:Name="StartupPath" TextWrapping="Wrap" Foreground="#AFBCC4" FontSize="11" Margin="0,0,0,10" />
        <CheckBox x:Name="StartAtMaxSpeed" Content="最初から最高速で始める" />
        <TextBlock Text="加速を待たず、1秒目から最高速・最短間隔になります。" TextWrapping="Wrap" Foreground="#AFBCC4" FontSize="11" Margin="0,0,0,10" />
        <TextBlock x:Name="Statistics" Foreground="#AFBCC4" Margin="0,8,0,8" />
      </StackPanel>
    </ScrollViewer>
    <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
      <Button Content="キャンセル" IsCancel="True" />
      <Button Content="保存する" IsDefault="True" Click="SaveClicked" Background="#8DF0C6" Foreground="#15212B" BorderThickness="0" />
    </StackPanel>
  </Grid>
</Window>
